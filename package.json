{
  "name": "hoity-toity",
  "description": "Feature Packed Code Editor Web Component",
  "version": "0.0.5",
  "type": "module",
  "main": "hoity-toity.js",
  "scripts": {
    "demo": "http-server -c-1 -o .",
    "build": "rollup ./src/hoity-toity.js -f iife -o hoity-toity.js -p @rollup/plugin-node-resolve",
    "save": "git add .; git commit -m 'Updated Release'; npm version patch; npm publish; git push --follow-tags;"
  },
  "keywords": [
    "webcomponent",
    "codeeditor"
  ],
  "author": "@catpea",
  "license": "GPL",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/catpea/hoity-toity.git"
  },
  "bugs": {
    "url": "https://github.com/catpea/hoity-toity/issues"
  },
  "homepage": "https://github.com/catpea/hoity-toity#readme",
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.10",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.4.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "codemirror": "^6.0.2",
    "rollup": "^4.52.3"
  }
